// ============================================
// PRODUCTION WORKFLOW
// ============================================

enum ProductionOrderStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  PARTIALLY_COMPLETED   // Closed with fewer units than planned — shortfall exists
  COMPLETED
  CANCELLED
}

enum ProductionStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
}

model ProductionOrder {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber         String    @unique   // e.g. "PRD-2026-0001"
  
  productId           String    @db.ObjectId
  product             Product   @relation(fields: [productId], references: [id])
  
  // Quantity tracking — started may differ from what's finally packaged
  quantity            Int                 // original planned quantity (kept for backward compat)
  quantityStarted     Int?                // units that entered production
  quantityPassed      Int?                // units that passed final QC
  quantityRejected    Int?                // units scrapped / irreparable
  quantityReworked    Int?                // units sent back for rework at some point
  quantityPackaged    Int?                // units actually packaged and ready for store
  yieldRate           Float?              // (quantityPassed / quantityStarted) * 100
  
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?
  
  status              ProductionOrderStatus @default(DRAFT)
  priority            OrderPriority         @default(NORMAL)
  
  notes               String?
  
  // Manager who created / oversees
  managerId           String    @db.ObjectId
  manager             User      @relation("ProductionOrderManager", fields: [managerId], references: [id])
  
  stages              ProductionStageEntry[]
  qcEntries           ProductionQCEntry[]
  materialRequisitions ProductionMaterialRequisition[]
  productionRequests  ProductionRequest[]
  units               ProductionUnit[]

  // Store integration
  storeReceiptCreated Boolean   @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@map("production_orders")
}

model ProductionStageEntry {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  
  productionOrderId   String    @db.ObjectId
  productionOrder     ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  
  stageName           String              // "PREPARATION", "ASSEMBLY", "QUALITY_CONTROL"
  stageLabel          String              // "Preparation Station (Soldering/Staging)"
  sortOrder           Int                 // 1, 2, 3
  
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  actualStart         DateTime?
  actualEnd           DateTime?
  
  status              ProductionStageStatus @default(NOT_STARTED)
  
  // Person responsible for the stage
  responsibleId       String?   @db.ObjectId
  responsible         User?     @relation("StageResponsible", fields: [responsibleId], references: [id])
  
  completedAt         DateTime?
  completedById       String?   @db.ObjectId
  
  actionItems         ProductionActionItem[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@map("production_stage_entries")
}

model ProductionActionItem {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  
  stageEntryId        String    @db.ObjectId
  stageEntry          ProductionStageEntry @relation(fields: [stageEntryId], references: [id], onDelete: Cascade)
  
  stepId              String              // "P-1", "A-3", "QC-5"
  actionName          String              // "Sign Out All Required Parts from Store"
  defaultResponsibility String            // "Store Keeper / Assembly Lead"
  outputNextStep      String              // "Complete Parts Kit"
  focusGoal           String?             // Quality gate / notes
  sortOrder           Int
  
  // Decision-point blueprint fields
  isDecisionPoint     Boolean   @default(false)
  
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  
  // Person assigned to this action blueprint
  responsibleId       String?   @db.ObjectId
  responsible         User?     @relation("ActionItemResponsible", fields: [responsibleId], references: [id])
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  unitTrackings       UnitStepTracking[]
  
  @@map("production_action_items")
}

model UnitStepTracking {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  
  unitId            String               @db.ObjectId
  unit              ProductionUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  actionItemId      String               @db.ObjectId
  actionItem        ProductionActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  
  status            ActionItemStatus     @default(PENDING)
  
  decisionOutcome   String?              // "PASS" | "FAIL" | "REWORK"
  rejectionReason   String?
  rejectionCategory String?
  
  startedAt         DateTime?
  completedAt       DateTime?
  
  completedById     String?              @db.ObjectId
  completedBy       User?                @relation("StepTrackingCompleter", fields: [completedById], references: [id])
  
  notes             String?
  
  activities        ProductionStepActivity[]
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  
  @@unique([unitId, actionItemId])
  @@map("unit_step_trackings")
}

// Per-step comments and file attachments — used by all production workers
model ProductionStepActivity {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId

  unitStepTrackingId String    @db.ObjectId
  unitStepTracking   UnitStepTracking @relation(fields: [unitStepTrackingId], references: [id], onDelete: Cascade)

  authorId          String    @db.ObjectId
  author            User      @relation("StepActivityAuthor", fields: [authorId], references: [id])

  // "COMMENT" | "ATTACHMENT" | "STATUS_CHANGE"
  type              String    @default("COMMENT")

  comment           String?

  // [{name, mimeType, base64, sizeBytes}] — stored for images/PDFs uploaded from phones
  attachments       Json?

  createdAt         DateTime  @default(now())

  @@map("production_step_activities")
}

// Structured record for each QC checkpoint outcome — pass/fail/rework log
model ProductionQCEntry {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  
  productionOrderId   String    @db.ObjectId
  productionOrder     ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  
  productionUnitId    String?   @db.ObjectId
  productionUnit      ProductionUnit? @relation(fields: [productionUnitId], references: [id], onDelete: Cascade)
  
  checkpointStepId    String              // "P-3", "A-2.6", "QC-2", "QC-6"
  checkpointName      String              // human-readable label
  
  outcome             String              // "PASS" | "FAIL" | "PARTIAL" | "REWORK"
  failureCategory     String?             // "COMPONENT_DEFECT" | "ASSEMBLY_FAULT" | "WIRING_ERROR" | "QC_FAILURE" | "OTHER"
  failureDetails      String?             // free-text description of what failed
  correctiveAction    String?             // what was done to address it
  
  recordedById        String    @db.ObjectId
  recordedBy          User      @relation("QCEntryRecorder", fields: [recordedById], references: [id])
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@map("production_qc_entries")
}

// ============================================
// MATERIAL REQUISITION WORKFLOW (P-1)
// Production dept → Inventory dept formal BOM sign-out request
// ============================================

enum RequisitionStatus {
  PENDING              // Sent, awaiting inventory action
  PARTIALLY_FULFILLED  // Some items issued, some still pending
  FULFILLED            // All items issued — P-1 can auto-complete
  CANCELLED
}

// One requisition per production order (can be re-raised if items run out)
model ProductionMaterialRequisition {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  requisitionNumber   String    @unique   // "MRQ-2026-0001"

  productionOrderId   String?   @db.ObjectId
  productionOrder     ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  productionUnitId    String?   @db.ObjectId
  productionUnit      ProductionUnit? @relation(fields: [productionUnitId], references: [id], onDelete: Cascade)

  productReturnId     String?   @db.ObjectId
  productReturn       ProductReturn?   @relation(fields: [productReturnId], references: [id], onDelete: Cascade)

  researchProjectId   String?   @db.ObjectId
  researchProject     ResearchProject? @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  status              RequisitionStatus @default(PENDING)

  // Who raised it (production manager / assembly lead)
  requestedById       String    @db.ObjectId
  requestedBy         User      @relation("MRQRequester", fields: [requestedById], references: [id])

  // Who fulfilled it (store keeper / inventory team)
  fulfilledById       String?   @db.ObjectId
  fulfilledBy         User?     @relation("MRQFulfiller", fields: [fulfilledById], references: [id])
  fulfilledAt         DateTime?

  notes               String?   // Production's notes (urgency, special handling)
  inventoryNotes      String?   // Store keeper's remarks on fulfillment

  items               ProductionMaterialRequisitionItem[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("production_material_requisitions")
}

// One row per BOM material in the requisition
model ProductionMaterialRequisitionItem {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId

  requisitionId       String    @db.ObjectId
  requisition         ProductionMaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  materialId          String    @db.ObjectId
  material            Material  @relation("MaterialRequisitionItems", fields: [materialId], references: [id])

  // BOM-derived quantities
  quantityRequired    Float     // qty per unit × production order quantity
  quantityIssued      Float?    // what store keeper actually signed out

  // PENDING | ISSUED | PARTIAL | UNAVAILABLE
  status              String    @default("PENDING")
  stockAtRequest      Float?    // snapshot of stock when request was made
  notes               String?   // e.g. "Only 8 in stock — remainder on order"

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("production_material_requisition_items")
}

// ============================================
// PRODUCT RETURNS
// ============================================

enum ReturnStatus {
  RECEIVED
  INSPECTING
  PENDING_APPROVAL
  IN_REPAIR
  REPAIR_COMPLETED
  READY_FOR_DISPATCH
  DISPATCHED
  SCRAPPED
}

model ProductReturn {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  returnNumber    String       @unique
  dateReceived    DateTime     @default(now())

  customerId      String       @db.ObjectId
  customer        Customer     @relation(fields: [customerId], references: [id])
  
  orderId         String?      @db.ObjectId
  order           Order?       @relation(fields: [orderId], references: [id])
  
  productId       String       @db.ObjectId
  product         Product      @relation(fields: [productId], references: [id])
  
  unitId          String?
  serialNumber    String?
  quantity        Int          @default(1)
  
  issueReported   String
  condition       String?
  
  status          ReturnStatus @default(RECEIVED)
  
  evaluationNotes String?
  
  recommendedAction String?
  recommendedById   String?    @db.ObjectId
  recommendedBy     User?      @relation("ReturnRecommender", fields: [recommendedById], references: [id])
  recommendationDate DateTime?
  
  repairNotes     String?
  partsReplaced   Json?
  repairCost      Float?
  
  dateDispatched  DateTime?
  dispatchNotes   String?
  
  receivedById    String       @db.ObjectId
  receivedBy      User         @relation("ReturnReceiver", fields: [receivedById], references: [id])
  
  handledById     String?      @db.ObjectId
  handledBy       User?        @relation("ReturnHandler", fields: [handledById], references: [id])
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  storeReceiptCreated Boolean      @default(false)

  materialRequisitions ProductionMaterialRequisition[]
  repairTasks          ReturnRepairTask[]
  returnUnits          ReturnUnit[]

  @@map("product_returns")
}

model ReturnUnit {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId

  returnId        String        @db.ObjectId
  return          ProductReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  unitNumber      Int           // 1, 2, 3… per return
  serialNumber    String?

  status          ReturnStatus  @default(RECEIVED)

  // Stage 2: Inspection
  evaluationNotes       String?
  evaluationAttachments Json?   // AttachmentFile[]
  inspectedById         String?   @db.ObjectId
  inspectedBy           User?     @relation("ReturnUnitInspector", fields: [inspectedById], references: [id])
  inspectedAt           DateTime?

  // Stage 3: Manager Approval
  recommendedAction     String?
  approvalAttachments   Json?   // AttachmentFile[]
  approvedById          String?   @db.ObjectId
  approvedBy            User?     @relation("ReturnUnitApprover", fields: [approvedById], references: [id])
  approvedAt            DateTime?

  repairTasks     ReturnRepairTask[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("return_units")
}

model ReturnRepairTask {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId

  returnId    String        @db.ObjectId
  return      ProductReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  returnUnitId  String?     @db.ObjectId
  returnUnit    ReturnUnit? @relation(fields: [returnUnitId], references: [id], onDelete: Cascade)

  name        String
  sortOrder   Int           @default(0)
  status      String        @default("PENDING") // PENDING | COMPLETED

  assignedToId  String?     @db.ObjectId
  assignedTo    User?       @relation("ReturnRepairTaskAssignee", fields: [assignedToId], references: [id])

  completedAt   DateTime?
  completedById String?     @db.ObjectId
  completedBy   User?       @relation("ReturnRepairTaskCompleter", fields: [completedById], references: [id])
  notes         String?
  attachments   Json?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("return_repair_tasks")
}

// ============================================
// UNIT REWORK
// ============================================

model UnitRework {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId

  productionUnitId  String    @db.ObjectId
  productionUnit    ProductionUnit @relation(fields: [productionUnitId], references: [id], onDelete: Cascade)

  round             Int       @default(1)   // 1st rework, 2nd rework, etc.
  status            String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  triggeredByStepId String?   // QC step that initiated this rework, e.g. "QC-1" or "QC-3"
  faultDescription  String?
  notes             String?

  createdById       String    @db.ObjectId
  createdBy         User      @relation("ReworkCreator", fields: [createdById], references: [id])

  completedAt       DateTime?
  completedById     String?   @db.ObjectId
  completedBy       User?     @relation("ReworkCompleter", fields: [completedById], references: [id])

  tasks             UnitReworkTask[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("unit_reworks")
}

model UnitReworkTask {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId

  reworkId      String     @db.ObjectId
  rework        UnitRework @relation(fields: [reworkId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  sortOrder     Int        @default(0)
  status        String     @default("PENDING") // PENDING | COMPLETED | SKIPPED

  completedAt   DateTime?
  completedById String?    @db.ObjectId
  completedBy   User?      @relation("ReworkTaskCompleter", fields: [completedById], references: [id])
  notes         String?
  attachments   Json?      // [{ name, mimeType, base64, sizeBytes }]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("unit_rework_tasks")
}

// ============================================
// RESEARCH & DEVELOPMENT
// ============================================

enum ResearchProjectStatus {
  OPEN
  CLOSED
}

model ResearchProject {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  projectNumber String                @unique  // "RD-2026-0001"
  title         String
  description   String?
  status        ResearchProjectStatus @default(OPEN)

  createdById   String                @db.ObjectId
  createdBy     User                  @relation("RDProjectCreator", fields: [createdById], references: [id])

  closedAt      DateTime?
  closedById    String?               @db.ObjectId
  closedBy      User?                 @relation("RDProjectCloser", fields: [closedById], references: [id])

  reopenedAt    DateTime?
  reopenedById  String?               @db.ObjectId
  reopenedBy    User?                 @relation("RDProjectReopener", fields: [reopenedById], references: [id])

  tasks                ResearchTask[]
  notes                ResearchNote[]
  materialRequisitions ProductionMaterialRequisition[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("research_projects")
}

model ResearchTask {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId

  researchProjectId     String          @db.ObjectId
  researchProject       ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  name                  String
  status                String          @default("PENDING")  // PENDING | DONE

  assignedToId          String?         @db.ObjectId
  assignedTo            User?           @relation("RDTaskAssignee", fields: [assignedToId], references: [id])

  completionDescription String?
  attachments           Json?           // [{ name, mimeType, base64, sizeBytes }] — required when marking done

  completedAt           DateTime?
  completedById         String?         @db.ObjectId
  completedBy           User?           @relation("RDTaskCompleter", fields: [completedById], references: [id])

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("research_tasks")
}

model ResearchNote {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId

  researchProjectId String          @db.ObjectId
  researchProject   ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  content           String
  authorId          String          @db.ObjectId
  author            User            @relation("RDNoteAuthor", fields: [authorId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("research_notes")
}

// ============================================
// INVESTOR REPORT
// ============================================

model InvestorReportDraft {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId

  // Period key this draft belongs to (e.g. "quarterly", "yearly", "alltime")
  period               String

  // KPI figures — auto-populated from live data on first load, editable by admin
  revenue              Float?
  profit               Float?
  productionVolume     Float?
  inventoryValue       Float?

  // Narrative sections — entirely admin-authored
  executiveSummary     String?
  financialNarrative   String?
  operationalNarrative String?
  salesGrowthNarrative String?
  strategyPipeline     String?
  marketOpportunity    String?
  riskMitigation       String?
  outlookForecast      String?

  // Audit fields
  lastEditedBy         String?
  lastEditedAt         DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("investor_report_drafts")
}

model InvestorReportArchive {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId

  // Identity
  period               String
  periodLabel          String
  title                String?

  // KPI snapshot
  revenue              Float?
  profit               Float?
  productionVolume     Float?
  inventoryValue       Float?

  // Derived metrics snapshot
  profitMargin         Float?
  collectionRate       Float?
  yieldRate            Float?
  reworkRate           Float?
  lowStockCount        Int?
  outOfStockCount      Int?

  // Supporting tables stored as JSON
  topProducts          Json?
  topCustomers         Json?
  receivablesAging     Json?

  // Narrative sections
  executiveSummary     String?
  financialNarrative   String?
  operationalNarrative String?
  salesGrowthNarrative String?
  strategyPipeline     String?
  marketOpportunity    String?
  riskMitigation       String?
  outlookForecast      String?

  // Email send tracking
  lastSentTo           String[]
  lastSentAt           DateTime?
  sendCount            Int       @default(0)

  // Audit
  archivedBy           String?
  generatedAt          String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("investor_report_archives")
}
